# Server-only. Put the Codyssey virtual key in the root .env, never in VITE_ variables.
COPA_API_KEY=
COPA_BASE_URL=https://copa.codyssey.kr/v1
COPA_MODEL=gpt-5.4
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:5173,http://localhost:5173
SESSION_TTL_SECONDS=1800
AI_TIMEOUT_SECONDS=45

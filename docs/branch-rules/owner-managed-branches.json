{
  "name": "owner-managed-branches",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [
    {"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always"}
  ],
  "conditions": {
    "ref_name": {"include": ["~ALL"], "exclude": ["refs/heads/canary"]}
  },
  "rules": [{"type": "creation"}, {"type": "update"}, {"type": "deletion"}]
}

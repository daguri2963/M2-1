{
  "name": "integration-checks",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {"include": ["refs/heads/dev", "refs/heads/production"], "exclude": []}
  },
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": ["merge"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "required_status_checks": [
          {"context": "Promotion policy", "integration_id": 15368},
          {"context": "Backend checks", "integration_id": 15368},
          {"context": "Frontend checks", "integration_id": 15368},
          {"context": "Product data checks", "integration_id": 15368}
        ]
      }
    }
  ]
}
